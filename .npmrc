# npm 12 defaults allow-git to "none", refusing any git-protocol dependency — including
# csvx-ts, which this project depends on directly (github:DevShedLabs/csvx-ts#<tag>) because
# that's how csvx-cli already depends on csvx-go (tag-resolved, no registry — see
# ../csvx-spec/AGENTS.md). "root" permits git deps declared in THIS package.json while still
# refusing git deps pulled in transitively by a third-party dependency, which is the actual
# supply-chain protection npm 12 added — so this is the narrow, intended opt-in, not a blanket
# bypass. See https://docs.npmjs.com/cli/v12/using-npm/config#allow-git
allow-git=root
